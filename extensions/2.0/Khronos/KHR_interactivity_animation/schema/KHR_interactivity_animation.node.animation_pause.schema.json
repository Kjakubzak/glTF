{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "KHR_interactivity_animation.node.animation_pause.schema.json",
    "title": "animation/pause Node",
    "type": "object",
    "description": "Pauses a running animation, preserving current time.",
    "allOf": [{ "$ref": "glTFProperty.schema.json" }],
    "properties": {
        "type": {
            "const": "animation/pause",
            "description": "Node type identifier."
        },
        "inputFlows": {
            "type": "array",
            "description": "Input flow sockets.",
            "items": {
                "type": "object",
                "properties": {
                    "id": { "const": "in" }
                }
            },
            "minItems": 1,
            "maxItems": 1
        },
        "outputFlows": {
            "type": "array",
            "description": "Output flow sockets.",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "anyOf": [
                            { "const": "out" },
                            { "const": "err" }
                        ]
                    }
                }
            },
            "minItems": 2,
            "maxItems": 2
        },
        "inputValues": {
            "type": "object",
            "description": "Input value sockets.",
            "properties": {
                "playbackId": {
                    "type": "object",
                    "description": "Handle from animation/start.",
                    "properties": {
                        "type": { "const": "int" }
                    },
                    "required": ["type"]
                }
            },
            "required": ["playbackId"]
        },
        "extensions": {},
        "extras": {}
    },
    "required": ["type", "inputFlows", "outputFlows", "inputValues"]
}
