{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "KHR_interactivity_animation.node.animation_setSpeed.schema.json",
    "title": "animation/setSpeed Node",
    "type": "object",
    "description": "Changes playback speed of a running animation. Negative values reverse playback.",
    "allOf": [{ "$ref": "glTFProperty.schema.json" }],
    "properties": {
        "type": {
            "const": "animation/setSpeed",
            "description": "Node type identifier."
        },
        "inputFlows": {
            "type": "array",
            "description": "Input flow sockets.",
            "items": {
                "type": "object",
                "properties": {
                    "id": { "const": "in" }
                }
            },
            "minItems": 1,
            "maxItems": 1
        },
        "outputFlows": {
            "type": "array",
            "description": "Output flow sockets.",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "anyOf": [
                            { "const": "out" },
                            { "const": "err" }
                        ]
                    }
                }
            },
            "minItems": 2,
            "maxItems": 2
        },
        "inputValues": {
            "type": "object",
            "description": "Input value sockets.",
            "properties": {
                "playbackId": {
                    "type": "object",
                    "description": "Handle from animation/start.",
                    "properties": {
                        "type": { "const": "int" }
                    },
                    "required": ["type"]
                },
                "speed": {
                    "type": "object",
                    "description": "Speed multiplier. Negative values reverse playback.",
                    "properties": {
                        "type": { "const": "float" }
                    },
                    "required": ["type"]
                }
            },
            "required": ["playbackId", "speed"]
        },
        "extensions": {},
        "extras": {}
    },
    "required": ["type", "inputFlows", "outputFlows", "inputValues"]
}
